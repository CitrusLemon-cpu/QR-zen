<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/green_500" android:gravity="center" android:orientation="vertical">
    <TextView android:id="@+id/tvCount" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="0" android:textColor="@color/white" android:textSize="24sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="blocks" android:textColor="@color/white" android:textSize="11sp" />
</LinearLayout>
